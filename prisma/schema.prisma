generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model QrBiometricReading {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  deviceId          String
  decodedData       String
  scanStatus        String   @default("success")
  entryState        String   @default("IN")
  characterCount    Int      @default(0)
  studentInfo       Json?
  studentPhotoUrl   String?
  studentInfoStatus String   @default("not_applicable")
  studentInfoError  String?
  enrollmentKey     String?
  attendanceEventId String?
  createdAt         DateTime @default(now())

  @@index([deviceId, createdAt])
  @@index([decodedData, createdAt])
  @@index([attendanceEventId])
  @@index([enrollmentKey, createdAt])
  @@index([createdAt])
  @@map("qr_biometric_readings")
}

model QrBiometricDeletion {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  scanId      String   @unique
  deviceId    String
  decodedData String
  deletedAt   DateTime @default(now())

  @@index([deviceId, deletedAt])
  @@map("qr_biometric_deletions")
}

model SupportInquiry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("support_inquiries")
}

model Device {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  deviceNumber       String    @unique
  name               String
  projectType        String    @default("qr-biometric")
  ssid               String    @default("hotspot")
  wifiPassword       String    @default("password")
  firmware           String    @default("v1.0.0")
  deviceKind         String    @default("QR_SCANNER")
  enabled            Boolean   @default(true)
  apiVersion         Int       @default(1)
  location           String    @default("ICC, IIT Roorkee")
  apiKeyHash         String?
  apiKeyPreview      String?
  apiKeyCreatedAt    DateTime?
  apiKeyLastUsedAt   DateTime?
  macAddress         String?
  macAddressLockedAt DateTime?
  lastSeenAt         DateTime?
  lastHeartbeatAt    DateTime?
  disabledAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([projectType, createdAt])
  @@index([deviceKind, enabled])
  @@index([macAddress])
}

model StudentIdentity {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  enrollmentKey   String   @unique
  enrollmentNo    String
  doswUrl         String   @unique
  fullName        String?
  profile         Json?
  studentPhotoUrl String?
  photoVersion    Int      @default(1)
  firstMappedAt   DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([lastSeenAt])
  @@map("student_identities")
}

model AttendanceEvent {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  eventId            String    @unique
  deduplicationKey   String    @unique
  payloadHash        String
  sourceType         String
  sourceDeviceId     String
  deviceSequence     String?
  bootId             String?
  intent             String
  enrollmentKey      String?
  studentIdentityId  String?   @db.ObjectId
  doswUrl            String?
  occurredAt         DateTime
  receivedAt         DateTime  @default(now())
  timeQuality        String
  status             String
  effectiveState     String?
  duplicateOfEventId String?
  projectionVersion  Int?
  fingerprintSlot    Int?
  fingerprintIndex   Int?
  voidedAt           DateTime?
  voidReason         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([enrollmentKey, status, occurredAt])
  @@index([studentIdentityId, occurredAt])
  @@index([sourceDeviceId, deviceSequence])
  @@index([sourceDeviceId, fingerprintSlot, fingerprintIndex])
  @@index([status, updatedAt])
  @@map("attendance_events")
}

model FingerprintEnrollment {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  deviceId         String
  enrollmentKey    String
  fingerprintSlot  Int
  fingerprintIndex Int?
  state            String   @default("ENROLL_PENDING")
  enabled          Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([deviceId, fingerprintSlot])
  @@index([deviceId, enrollmentKey])
  @@index([enrollmentKey])
  @@map("fingerprint_enrollments")
}

model FingerprintCommand {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  commandId        String   @unique
  deviceId         String
  commandType      String
  enrollmentKey    String?
  fingerprintSlot  Int?
  fingerprintIndex Int?
  payload          Json?
  status           String   @default("PENDING")
  errorMessage     String?
  deliveredAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([deviceId, status, createdAt])
  @@index([status, createdAt])
  @@index([deviceId, fingerprintSlot])
  @@map("fingerprint_commands")
}

model AttendanceProjection {
  id                     String   @id @default(auto()) @map("_id") @db.ObjectId
  enrollmentKey          String   @unique
  studentIdentityId      String?  @db.ObjectId
  currentState           String   @default("OUT")
  latestEffectiveEventId String?
  latestOccurredAt       DateTime?
  version                Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([updatedAt])
  @@map("attendance_projections")
}

model AttendanceChange {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  sequence          BigInt   @unique
  kind              String
  audienceDeviceId  String?
  attendanceEventId String?
  snapshot          Json
  createdAt         DateTime @default(now())

  @@index([audienceDeviceId, sequence])
  @@index([createdAt])
  @@map("attendance_changes")
}

model AttendanceFeedCounter {
  id        String   @id @map("_id")
  value     BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@map("attendance_feed_counters")
}

model AccessAccount {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  role         String
  name         String
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role, createdAt])
  @@map("access_accounts")
}
